{
  "manifest_version": 3,
  "name": "開盤配對助手（Polymarket 5 分鐘盤）",
  "version": "0.4.0",
  "description": "人工模式＋練習模式（預設，不花錢）。第一張、第二張的時機都由人決定；面板第三格即時顯示「現在補對面能賺幾 %」，空白鍵用當下價格、同樣股數鎖定；擋違規、每場記錄。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://polymarket.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://polymarket.com/*"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
