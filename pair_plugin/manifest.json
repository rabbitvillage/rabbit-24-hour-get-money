{
  "manifest_version": 3,
  "name": "開盤配對助手（Polymarket 5 分鐘盤）",
  "version": "0.3.0",
  "description": "人工模式＋練習模式（預設，不花錢：照真實盤口模擬成交、收盤後照真實結果算損益）。第一張由人決定時機；第二張空白鍵掛限價（同股數、零手續費）；擋違規、每場記錄。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://polymarket.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://polymarket.com/*"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
