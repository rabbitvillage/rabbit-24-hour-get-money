# Copy to btc5m_sim/.env (git-ignored). Never commit the real file.
TG_TOKEN=
# Optional: leave empty, send /start to the bot once, and the sim finds the chat itself.
TG_CHAT_ID=
ENTRY_WINDOW=45
LAST_ENTRY=5
MIN_PRICE=0.98
MAX_PRICE=0.99
SHARES=5
POLL=1.0
TZ_OFFSET=8
# Use an absolute path under systemd: EnvironmentFile overrides the unit's Environment=DATA_DIR.
DATA_DIR=data
# Shadow variants scored in parallel from the same book polls: w<seconds>_p<min price in cents>.
VARIANTS=w45_p98,w30_p98,w20_p98,w45_p99,w30_p99
# Sample BTC spot (Coinbase, fallback Kraken) once a second from this many seconds before close.
SPOT_WINDOW=60
