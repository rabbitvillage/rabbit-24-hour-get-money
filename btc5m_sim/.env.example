# Copy to btc5m_sim/.env (git-ignored). Never commit the real file.
TG_TOKEN=
# Optional: leave empty, send /start to the bot once, and the sim finds the chat itself.
# One or more chat ids, comma separated; every user must have pressed /start on the bot once.
TG_CHAT_ID=
ENTRY_WINDOW=45
LAST_ENTRY=5
MIN_PRICE=0.98
MAX_PRICE=0.99
SHARES=5
POLL=1.0
TZ_OFFSET=8
# Use an absolute path under systemd: EnvironmentFile overrides the unit's Environment=DATA_DIR.
DATA_DIR=data
# Shadow variants scored in parallel from the same book polls: w<seconds>_p<min price in cents>.
# price floor for the m (price-cap) variants; 2026-10-21 raised 0.50 -> 0.80 after a live loss at 0.55
M_FLOOR=0.85
# Distance threshold multiplier: the rule names say s20 (= $20 for BTC); 2026-10-28 fish: 0.75 -> $15 now that the line is exact
# (the $20 was tuned to the old noisy line). Per-asset files override: SOL 0.003, ETH 0.0223 (the ETH default 0.0297 x 0.75).
DIST_SCALE=0.75   # 2026-10-28 fish: 0.80-0.84 entries lost 25% (price implies 18%) and were net negative -> 0.85 (FR-20261028-floor-085)
VARIANTS=w45_p98,w30_p98,w20_p98,w45_p99,w30_p99,w45_p98_s,w45_p98_s10,w45_p98_s20,w45_p98_s30,w60_m95_s10,w60_m95_s20,w90_m99_s30,w120_m99_s40,w45_m99_s20
# Record both sides' best ask every second from this many seconds before close (sim_book.csv); spot sampling starts here too.
BOOK_WINDOW=150
# Sample BTC spot (Coinbase exchange mid, fallback Kraken) once a second from this many seconds before close.
SPOT_WINDOW=150

# ---- phase 1 executor (btc5m_sim/live.py). Keep the real values in btc5m_sim/.live.env (0600), NOT here. ----
# off = simulation only (default) | dry = build every order, write it to data/live_orders.csv, send nothing | live = real FOK orders
EXEC_MODE=off
# which rules may trade: empty = all (main + every variant). Example: LIVE_VARIANTS=w45_p98_s,w60_m95_s20
LIVE_VARIANTS=
LIVE_SHARES=5
# 2026-10-29 wallet $1,044 (fish): risk limits rescaled with the per-trade size (FR-20261029-wallet-1044)
LIVE_MAX_SHARES=80
LIVE_SLIP=0.01
MAX_DAILY_LOSS_VARIANT=260
MAX_DAILY_LOSS_TOTAL=400
# capital floor: stop placing orders while the proxy wallet's USDC is below this (checked every BALANCE_TTL seconds)
MIN_BALANCE_USDC=750
BALANCE_TTL=60
# touch this file to stop every rule immediately (orders already filled still settle)
KILL_FILE=/opt/rabbit-24-hour-get-money/btc5m_sim/data/STOP
# Polymarket rejects orders from US IPs: send authenticated exchange calls through an HTTP proxy that exits in an allowed region
# (racknerd: the local sing-box inbound -> Sofia). Market data stays direct.
ORDER_PROXY=http://127.0.0.1:10809
# live only — put these in .live.env: SIGNER_URL, SIGNER_TOKEN, SIGNER_ADDRESS, CLOB_API_KEY, CLOB_API_SECRET, CLOB_API_PASSPHRASE
# Per market, at most this many real orders on this asset (first rules to fire win). 0 = unlimited.
LIVE_MAX_ORDERS_PER_MARKET=2
# Choppy-market filter: skip entries when the price range seen since 150s-left is >= this many bps of the line. 0 = off.
CHOP_MAX_AMP_BPS=8
# Wallet balance: refreshed in the background every BALANCE_REFRESH s; an order only fetches it inline when the cache is older than BALANCE_STALE s.
BALANCE_REFRESH=30
BALANCE_STALE=300
# US stock market session pause: 1 = no real orders Mon-Fri 09:30-16:00 New York time (daylight saving handled); shadow data keeps coming.
LIVE_PAUSE_US_SESSION=0
# NYSE holidays (closed all day) and early closes (date=HH:MM New York); extend every year.
US_MARKET_HOLIDAYS=2026-11-26,2026-12-25
US_MARKET_EARLY_CLOSE=2026-11-27=13:00,2026-12-24=13:00
# Early warning: Telegram once a day when free USDC + unsettled orders drops below this (0 = off).
MIN_BALANCE_WARN=900
# Reversal-regime guard: after any loss of the live rules (real or shadow), no real orders for this many 5-minute markets (0 = off).
LIVE_LOSS_COOLDOWN_MARKETS=0
# Order size: fixed = LIVE_SHARES; wallet = (free USDC + unsettled orders) x LIVE_WALLET_FRACTION / price, between LIVE_MIN_SHARES and LIVE_MAX_SHARES.
LIVE_SIZE_MODE=fixed
LIVE_WALLET_FRACTION=0.125
LIVE_MIN_SHARES=5
# Real-time feeds: USE_WS=1 uses Coinbase + Polymarket websockets (REST fallback when data is older than WS_STALE s). POLL now defaults to 0.5 s.
USE_WS=1
# Distance line (FR-20261028-official-line): LINE_TWAP=1 measures distance from the official open (Chainlink 60 s TWAP via
# Polymarket's public stream, moved onto Coinbase's scale); LINE_TWAP=0 keeps the old line (on-chain aggregator at open) for
# decisions while the official line is still logged to sim_line.csv. 2026-10-28 16:5x: back to 1 (fish, after the SOL loss
# the old line let through: its error exceeded SOL's whole distance threshold).
LINE_TWAP=1
WS_STALE=2.5
